# PostgreSQL connection string (Neon / Vercel Postgres). Without it, local runs use embedded Postgres in .data/.
DATABASE_URL=
# Public canonical origin, e.g. https://www.maximus.vegas
NEXT_PUBLIC_SITE_URL=
# Public contact email (defaults to info@maximus.ltd)
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: secret (24+ chars) that grants administrator rights at /ru/admin/claim
ADMIN_BOOTSTRAP_TOKEN=
# Optional: copy of every application to an external HTTPS endpoint (applications are always stored in the database)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Optional: connection pool size per server instance
DATABASE_POOL_MAX=
