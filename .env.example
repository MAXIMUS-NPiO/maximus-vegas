# ---------------------------------------------------------------------------
# MAXIMUS VEGAS — environment variables. Never commit real values.
# Server-only unless the name starts with NEXT_PUBLIC_ (those are visible in the browser).
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Neon / Vercel Postgres). Without it, local runs use embedded Postgres in .data/.
# Use a separate database for preview deployments: previews must never write to production data.
DATABASE_URL=
# Public canonical origin, e.g. https://www.maximus.vegas (used for links in emails and payment return URLs)
NEXT_PUBLIC_SITE_URL=
# Public contact email (defaults to info@maximus.ltd)
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: secret (24+ chars) that grants administrator rights at /ru/admin/claim
ADMIN_BOOTSTRAP_TOKEN=
# Optional: copy of every application to an external HTTPS endpoint (applications are always stored in the database)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
# Optional: connection pool size per server instance
DATABASE_POOL_MAX=

# --- Email delivery (outbox). Without a transport, messages stay queued and the UI says email is not connected.
# Sender, e.g. "MAXIMUS VEGAS <no-reply@maximus.vegas>" — the domain must be verified with the provider.
MAIL_FROM=
# Either Resend …
RESEND_API_KEY=
# … or any SMTP server: smtps://user:password@smtp.example.com:465
SMTP_URL=
# "required" = email-first sign-up (account activates only after the emailed link). Needs a working transport.
SIGNUP_EMAIL_CONFIRMATION=

# --- Staff second factor. 32+ random characters; encrypts TOTP secrets at rest (AES-256-GCM).
# Changing or losing it makes existing factors unreadable: staff would need a reset.
MFA_SECRET_KEY=

# --- Scheduled maintenance (Vercel Cron sends it as a Bearer token). 16+ random characters.
CRON_SECRET=

# --- Payments. Collection stays OFF unless every item below is set AND an approved, complete offer exists.
# "1" to allow checkout at all.
PAYMENTS_ENABLED=
# "test" or "live"; must match the key type.
PAYMENTS_MODE=
# Stripe secret key (sk_test_… / sk_live_… or rk_…) and the endpoint's signing secret (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# "1" only after the merchant account is verified for MAXIMUS VEGAS L.L.C-FZ and this activity.
MERCHANT_VERIFIED=
# Exact legal name on the merchant account; must equal the offer's recipient (MAXIMUS VEGAS L.L.C-FZ).
MERCHANT_LEGAL_NAME=
# "1" required in addition for live keys (a separate, explicit authorisation).
PAYMENTS_LIVE_CONFIRMED=
# "1" to allow refunds from the admin workspace.
PAYMENTS_ALLOW_REFUNDS=
