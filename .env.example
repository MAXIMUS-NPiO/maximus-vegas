# Public canonical origin. Set to your final domain before production.
NEXT_PUBLIC_SITE_URL=
# Public business email, shown as a fallback contact when configured.
NEXT_PUBLIC_CONTACT_EMAIL=
# HTTPS endpoint that accepts and durably stores JSON inquiries.
LEAD_WEBHOOK_URL=
# Bearer token for that endpoint. Server-only; never prefix with NEXT_PUBLIC_.
LEAD_WEBHOOK_TOKEN=
# Optional: distributed abuse protection using Upstash Redis REST.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
