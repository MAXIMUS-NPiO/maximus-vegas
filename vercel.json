{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/maintenance",
      "schedule": "17 3 * * *"
    },
    {
      "path": "/api/cron/payments",
      "schedule": "37 3 * * *"
    },
    {
      "path": "/api/cron/experience",
      "schedule": "47 4 * * *"
    },
    {
      "path": "/api/cron/community",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/broadcasts",
      "schedule": "* * * * *"
    }
  ]
}
